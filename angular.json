{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "superelf": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "i18n": {
        "sourceLocale": "en",
        "locales": {
          "nl": {
            "translation": "src/locale/messages.nl.xlf",
            "subPath": ""
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "aot": true,
            "outputPath": "dist",
            "index": "src/index.html",
            "namedChunks": true,
            "sourceMap": true,
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": ["@angular/localize/init"],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              "src//assets/favicon/favicon.ico",
              "src/2627ere-assemble.ics",
              "src/2627ere-transfer.ics",
              "src/manifest.webmanifest",
              "src/robots.txt"
            ],
            "styles": [
              "src/sass/main.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "./sass/bootstrap"
              ],
              "sass": {
                "silenceDeprecations": ["mixed-decls", "color-functions", "global-builtin", "import"]
              }
            },
            "scripts": [],
            "browser": "src/main.ts"
          },
          "configurations": {
            "prod": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": true
              },
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "prod-nl": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": {
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": {
                  "inline": true
                }
              },
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "outputPath": "dist/",
              "localize": [
                "nl"
              ],
              "i18nMissingTranslation": "warning"
            },
            "dev-nl": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "localize": [
                "nl"
              ],
              "i18nMissingTranslation": "warning"
            },
            "nl": {
              "aot": true,
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "outputPath": "dist/",
              "localize": [
                "nl"
              ],
              "i18nMissingTranslation": "warning"
            },
            "acc": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.acc.ts"
                }
              ],
              "serviceWorker": true
            },
            "dev": {
              "optimization": false,
              "namedChunks": true,
              "extractLicenses": false,
              "sourceMap": true
            },
            "defaultConfiguration": "prod"
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "superelf:build"
          },
          "configurations": {
            "prod": {
              "buildTarget": "superelf:build:prod"
            },
            "dev": {
              "port": 4201,
              "buildTarget": "superelf:build:dev"
            },
            "dev-nl": {
              "buildTarget": "superelf:build:dev-nl"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "superelf:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "karmaConfig": "./karma.conf.js",
            "polyfills": ["@angular/localize/init"],
            "tsConfig": "src/tsconfig.spec.json",
            "scripts": [],
            "styles": [
              "src/sass/main.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "../../node_modules/bootstrap/scss"
              ]
            },
            "assets": [
              "src/assets",
              "src//assets/favicon/favicon.ico",
              "src/manifest.webmanifest"
            ]
          }
        }
      }
    },
    "superelf-e2e": {
      "root": "",
      "sourceRoot": "",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "./protractor.conf.js",
            "devServerTarget": "superelf:serve"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "app",
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": "bbc98f42-bcb3-4e47-9edd-46b8f92b9590",
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  }
}